<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Welcome!{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body>
        <header class="fixed-top d-flex align-items-center bg-white shadow-sm py-2 px-3 w-100">
            <div class="d-flex align-items-center justify-content-between w-100">
                <div class="d-flex align-items-center">
                    <a href="" class="d-flex align-items-center text-decoration-none">
                        <img src="{{ asset('img/burger.png') }}" alt="Logo" height="30">
                        <span class="d-none d-lg-block fw-bold text-dark">BrasilBurger</span>
                    </a>
                    <i class="bi bi-list fs-4 text-warning ms-3" style="cursor:pointer" onclick="toggleSidebar()"
                    ></i>
                </div>

                <div class="dropdown">
                    <button
                        class="btn bg-transparent border-0 d-flex align-items-center"
                        type="button"
                        data-bs-toggle="dropdown"
                        aria-expanded="false"
                    >
                        <i class="bi bi-person me-2 fs-5 text-warning"></i>
                        <div class="d-flex flex-column text-start">

                        </div>
                    </button>
                </div>
            </div>
        </header>

        <aside id="sidebar" class="sidebar">
            <ul class="sidebar-nav" id="sidebar-nav">
                <li class="nav-item mb-1">
                    <a
                        href="{{ path('app_dashboard') }}"
                        class="nav-link {{ app.request.attributes.get('_route') == 'app_dashboard' ? '' : 'collapsed' }}"
>
                        <i class="bi bi-grid"></i>
                        <span>Dashboard</span>
                    </a>
                </li>

                <li class="nav-item mb-1">
                    <a
                        href="{{ path('app_commande') }}"
                        class="nav-link {{ app.request.attributes.get('_route') starts with 'app_commande' ? '' : 'collapsed' }}"
                    >
                        <i class="bi bi-list"></i>
                        <span>Commandes</span>
                    </a>
                </li>

                <li class="nav-item mb-1">
                    <a
                        href="{{ path('app_burger') }}"
                        class="nav-link {{ app.request.attributes.get('_route') starts with 'app_burger' ? '' : 'collapsed' }}"
                    >
                        <i class="bi bi-fork-knife"></i>
                        <span>Burgers</span>
                    </a>
                </li>

                <li class="nav-item mb-1">
                    <a
                        href="{{ path('app_complement') }}"
                        class="nav-link {{ app.request.attributes.get('_route') starts with 'app_complement' ? '' : 'collapsed' }}"
                    >
                        <i class="bi bi-cup-straw"></i>
                        <span>Compléments</span>
                    </a>
                </li>
            </ul>
        </aside>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
        <script>
            function toggleSidebar() {
                document.body.classList.toggle('toggle-sidebar');
            }
        </script>
        {% block body %}{% endblock %}
    </body>
</html>

<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Welcome!{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body>
        <header class="fixed-top d-flex align-items-center bg-white shadow-sm py-2 px-3 w-100">
            <div class="d-flex align-items-center justify-content-between w-100">
                <div class="d-flex align-items-center">
                    <a href="" class="d-flex align-items-center text-decoration-none">
                        <img src="{{ asset('img/burger.png') }}" alt="Logo" height="30">
                        <span class="d-none d-lg-block fw-bold text-dark">BrasilBurger</span>
                    </a>
                    <i class="bi bi-list fs-4 text-warning ms-3" style="cursor:pointer" onclick="toggleSidebar()"
                    ></i>
                </div>

                <div class="dropdown text-end">
                    <a href="#" class="d-block link-body-emphasis text-decoration-none dropdown-toggle show text-warning" data-bs-toggle="dropdown" aria-expanded="true">
                        <i class="fas fa-user-circle"></i> {{ app.user ? app.user.nom ~ " " ~ app.user.prenom : 'User' }}
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end" style="position: absolute; inset: 0px 0px auto auto; margin: 0px; transform: translate(0px, 34px);" data-popper-placement="bottom-end">
                        <li><a class="dropdown-item" href="#"> {{ app.user ? app.user.roles[0] : '' }}</a></li>
                        <li><a class="dropdown-item" href="#"> Paramètres</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            {% if app.user %}
                                <a class="dropdown-item text-danger" href="{{ path('app_logout') }}">Déconnexion</a>
                            {% endif %}
                        </li>
                    </ul>
                </div>
            </div>
        </header>

        <aside id="sidebar" class="sidebar">
            <ul class="sidebar-nav" id="sidebar-nav">
                <li class="nav-item mb-1">
                    <a
                        href="{{ path('app_dashboard') }}"
                        class="nav-link {{ app.request.attributes.get('_route') == 'app_dashboard' ? '' : 'collapsed' }}"
>
                        <i class="bi bi-grid"></i>
                        <span>Dashboard</span>
                    </a>
                </li>

                <li class="nav-item mb-1">
                    <a
                        href="{{ path('app_commande') }}"
                        class="nav-link {{ app.request.attributes.get('_route') starts with 'app_commande' ? '' : 'collapsed' }}"
                    >
                        <i class="bi bi-list"></i>
                        <span>Commandes</span>
                    </a>
                </li>

                <li class="nav-item mb-1">
                    <a
                        href="{{ path('app_burger') }}"
                        class="nav-link {{ app.request.attributes.get('_route') starts with 'app_burger' ? '' : 'collapsed' }}"
                    >
                        <i class="bi bi-fork-knife"></i>
                        <span>Burgers</span>
                    </a>
                </li>

                <li class="nav-item mb-1">
                    <a
                        href="{{ path('app_complement') }}"
                        class="nav-link {{ app.request.attributes.get('_route') starts with 'app_complement' ? '' : 'collapsed' }}"
                    >
                        <i class="bi bi-cup-straw"></i>
                        <span>Compléments</span>
                    </a>
                </li>

                <li class="nav-item mb-1">
                    <a
                        href="{{ path('app_menu') }}"
                        class="nav-link {{ app.request.attributes.get('_route') starts with 'app_menu' ? '' : 'collapsed' }}"
                    >
                        <i class="bi bi-fork-knife"></i>
                        <span>Menus</span>
                    </a>
                </li>

                <li class="nav-item mb-1">
                    <a
                        href="{{ path('app_livraison') }}"
                        class="nav-link {{ app.request.attributes.get('_route') starts with 'app_livraison' ? '' : 'collapsed' }}"
                    >
                        <i class="bi bi-truck"></i>
                        <span>Livraisons</span>
                    </a>
                </li>
            </ul>
        </aside>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
        <script>
            function toggleSidebar() {
                document.body.classList.toggle('toggle-sidebar');
            }
        </script>
        {% block body %}{% endblock %}
    </body>
</html>

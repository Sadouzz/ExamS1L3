{% extends 'base.html.twig' %}

{% block title %}Liste des livraisons{% endblock %}

{% block body %}
    <main class="main" id="main">
        <div class="pagetitle">
            <h3>Liste des livraisons</h3>
            <nav>
                <ol class="breadcrumb">
                    <li class="breadcrumb-item">Accueil</li>
                    <li class="breadcrumb-item active" aria-current="page">Livraisons</li>
                </ol>
            </nav>
        </div>
        <div class="card mb-3 shadow border-0 rounded-0">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="mb-0">
                        <i class="bi bi-funnel-fill text-secondary me-2"></i>
                        Filtres et recherche
                    </h6>
                </div>

                {{ form_start(formSearchLivraison) }}
                <div class="row g-3">
                    <div class='col-lg-2 col-md-12'>
                        {{ form_row(formSearchLivraison.statut) }}
                    </div>
                    <div class='col-lg-1 col-md-12 align-content-end'>
                        <button class="btn btn-secondary">Filtrer</button>
                    </div>
                </div>
                {{ form_end(formSearchLivraison) }}
            </div>
        </div>


        <div class="card shadow border-0 rounded-0">
            <div class="p-3 border-bottom">
                <div class="d-flex justify-content-between align-items-center">
                    <h5 class="card-title m-0">
                        Liste des livraisons
                        <span class="badge bg-secondary ms-2">{{ count }}</span>
                    </h5>
                    <div class="text-muted small">
                        Page {{ pageEnCours }} sur {{ nbrePages }}

                        {% if count > 0 %}
                            {% set indexOfFirstItem = (pageEnCours - 1) * limit + 1 %}
                            {% set indexOfLastItem = indexOfFirstItem + livraisons|length - 1 %}

                            <span>
                                • Affichage de {{ indexOfFirstItem }} à {{ indexOfLastItem }} sur {{ count }}
                            </span>
                        {% endif %}
                    </div>
                </div>
            </div>
            <table class="table table-striped mb-0">
                <thead class="table-dark">
                <tr>
                    <th>#</th>
                    <th>Zone</th>
                    <th>Quartier</th>
                    <th>Statut</th>
                </tr>
                </thead>
                <tbody>

                {% for livraison in livraisons %}
                    <tr>
                        <td>{{ livraison.id }}</td>
                        <td>{{ livraison.zone }}</td>
                        <td>{{ livraison.quartier }}</td>
                        <td>{{ livraison.statut }}</td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="3" class="text-center text-muted py-4">
                            Aucune livraison trouvée
                        </td>
                    </tr>
                {% endfor %}

                </tbody>
            </table>
        </div>
        {% include "comps/pagination.html.twig" with {nbrePages:nbrePages, pageEnCours:pageEnCours, pathName:'app_livraison'} %}
    </main>
{% endblock %}

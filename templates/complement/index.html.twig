{% extends 'base.html.twig' %}

{% block body %}
    <main class="main" id="main">
        <div class="pagetitle">
            <h3>Liste des compléments</h3>
            <nav>
                <ol class="breadcrumb">
                    <li class="breadcrumb-item">Accueil</li>
                    <li class="breadcrumb-item active" aria-current="page">Dashboard</li>
                </ol>
            </nav>
        </div>
        <div class="card mb-3 shadow border-0 rounded-0">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="mb-0">
                        <i class="bi bi-funnel-fill text-secondary me-2"></i>
                        Filtres et recherche
                    </h6>
                </div>

                {{ form_start(formSearchComplement) }}
                <div class="row g-3">
                    <div class='col-lg-3 col-md-12'>
                        {{ form_row(formSearchComplement.typeComplement) }}
                    </div>
                    <div class='col-lg-2 col-md-12'>
                        {{ form_row(formSearchComplement.isArchived) }}
                    </div>
                    <div class='col-lg-1 col-md-12 align-content-end'>
                        <button class="btn btn-secondary">Filtrer</button>
                    </div>
                </div>
                {{ form_end(formSearchComplement) }}
            </div>
        </div>


        <div class="card shadow border-0 rounded-0">
            <div class="p-3 border-bottom">
                <div class="d-flex justify-content-between align-items-center">
                    <h5 class="card-title m-0">
                        Liste des compléments
                        <span class="badge bg-info ms-2">26</span>
                    </h5>
                </div>
            </div>
            <table class="table table-striped mb-0">
                <thead class="table-dark">
                <tr>
                    <th>#</th>
                    <th>Image</th>
                    <th>Nom</th>
                    <th>Prix</th>
                    <th>Categorie</th>
                    <th>Statut</th>
                </tr>
                </thead>
                <tbody>

                {% for complement in complements %}
                    <tr>
                        <td>{{ complement.id }}</td>
                        <td>
                            <img src="{{ complement.imageUrl }}" alt="{{ complement.libelle }}" style="max-width: 50px; max-height: 50px;">
                        </td>
                        <td>{{ complement.libelle }}</td>
                        <td>{{ complement.prix|number_format(0, ',', ' ') }} FCFA</td>
                        <td>{{ complement.typeComplement }}</td>
                        <td>
                            {% if complement.isArchived %}
                                <span class="badge bg-danger">Archivé</span>
                            {% else %}
                                <span class="badge bg-success">Non Archivé</span>
                            {% endif %}
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="6" class="text-center text-muted py-4">
                            Aucun complément trouvé
                        </td>
                    </tr>
                {% endfor %}

                </tbody>
            </table>
        </div>

    </main>
{% endblock %}

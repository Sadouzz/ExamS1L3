@using Models
@model Menu

@{
    ViewData["Title"] = "Détails du Menu";
    ViewData["PageTitle"] = "Menu";
}

<div class="container py-5">

    <div class="row align-items-center">

        <div class="col-md-6 text-center">
            <img src="@Model.ImageUrl" alt="@Model.Libelle" class="img-fluid" style="max-width:420px;" />
        </div>

        <div class="col-md-6">

            <h2 class="fw-bold text-uppercase" style="color:#8B2C0D">
                @Model.Libelle
            </h2>

            <p class="text-muted mb-3">
                Menu complet avec burgers, frites et boissons
            </p>

            <ul class="list-unstyled menu-summary">

                @foreach (var mb in Model.MenuBurgers)
                {
                    <li class="d-flex align-items-center mb-2">
                        <img src="@mb.Burger.ImageUrl" class="menu-icon me-2" style="max-width: 50px; max-height: 50px;" />
                        <span>
                            <strong>@mb.Quantite x</strong> @mb.Burger.Libelle
                        </span>
                    </li>
                }

                @foreach (var mc in Model.MenuComplements)
                {
                    <li class="d-flex align-items-center mb-2">
                        <img src="@mc.Complement.ImageUrl" class="menu-icon me-2"
                            style="max-width: 50px; max-height: 50px;" />
                        <span>
                            <strong>@mc.Quantite x</strong> @mc.Complement.Libelle
                        </span>
                    </li>
                }

            </ul>

            <h4 class="fw-bold mt-3" style="color:#8B2C0D">
                <span class="fw-bold">Prix: </span>@Model.Prix XOF
            </h4>

            @if (User.Identity.IsAuthenticated)
            {
                <a href="/commande/commander?type=menu&id=@Model.Id" class="btn btn-outline-danger rounded-pill px-4 mt-2">
                    COMMANDER
                </a>
            }
            else
            {
                <a asp-controller="Auth" asp-action="Login"
                    asp-route-returnUrl="@Url.Action("Commander", "Commande", new { type = "menu", id = Model.Id })"
                    class="btn btn-outline-danger rounded-pill px-4 mt-2">
                    SE CONNECTER
                </a>
            }

        </div>
    </div>
</div>
@using Models
@model Menu
@{
    ViewData["Title"] = "Détails du Menu";
}

<div class="container mt-5">
    <div class="row">
        <div class="col-md-6">
            <img src="@Model.ImageUrl" alt="@Model.Libelle" class="img-fluid rounded shadow" />
        </div>
        <div class="col-md-6">
            <h2>@Model.Libelle</h2>
            <p class="fw-bold text-success">@Model.Prix F CFA</p>

            <h5 class="mt-3">Burgers inclus :</h5>
            <ul>
                @foreach (var mb in Model.MenuBurgers)
                {
                    <li>@mb.Burger.Libelle x @mb.Quantite</li>
                }
            </ul>

            <h5>Compléments :</h5>
            <ul>
                @foreach (var mc in Model.MenuComplements)
                {
                    <li>@mc.Complement.Libelle x @mc.Quantite</li>
                }
            </ul>

            <a href="/commande/commander?type=menu&id=@Model.Id" class="btn btn-success btn-lg mt-3">
                Commander ce menu
            </a>
        </div>
    </div>
</div>
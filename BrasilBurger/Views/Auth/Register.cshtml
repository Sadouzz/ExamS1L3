@model Models.RegisterViewModel

@{
    ViewData["Title"] = "Créer un compte";
    Layout = "_AuthLayout";
}

<div class="container mt-5" style="max-width:450px">
    <h3 class="text-center mb-4">Créer un compte</h3>

    <form asp-action="Register" method="post">
        @Html.AntiForgeryToken()

        <div class="mb-3">
            <label>Nom</label>
            <input asp-for="Nom" class="form-control" />
        </div>

        <div class="mb-3">
            <label>Prénom</label>
            <input asp-for="Prenom" class="form-control" />
        </div>

        <div class="mb-3">
            <label>Téléphone</label>
            <input asp-for="Tel" class="form-control" />
        </div>

        <div class="mb-3">
            <label>Email</label>
            <input asp-for="Email" class="form-control" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label>Mot de passe</label>
            <input asp-for="Password" class="form-control" />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>

        <button class="btn btn-success w-100">Créer le compte</button>
    </form>

    <div class="text-center mt-3">
        <a asp-action="Login">Déjà un compte ? Se connecter</a>
    </div>
</div>
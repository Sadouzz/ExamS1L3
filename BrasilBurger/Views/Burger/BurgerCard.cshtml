@using Models
@model Burger

<div class="col-md-2 mb-4">
    <div
        class="card shadow rounded-1 border-0 h-100 shadow-sm d-flex flex-column align-items-center bg-transparent overflow-hidden">
        <div class="back-red position-relative h-100 w-100">
            <div class="card-body text-center text-white">
                <img src="@Model.ImageUrl" class="card-img-top" alt="@Model.Libelle"
                    style="max-height: 190px; max-width: 270px; object-fit: cover;" />
                <h2 class="card-title text-uppercase">@Model.Libelle</h2>
                <h4 class="card-text">@Model.Prix F CFA</h4>
                <a href="/burger/@Model.Id" class="btn btn-secondary w-100">
                    <i class="bi bi-cart-plus me-1"></i>Commander
                </a>
            </div>
        </div>
    </div>
</div>
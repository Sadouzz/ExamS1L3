@using Models
@model Burger
@{
    ViewData["Title"] = "Détails du Burger";
    ViewData["PageTitle"] = "Burger";
}

<div class="container mt-5">
    <div class="row">
        <div class="col-md-6">
            <img src="@Model.ImageUrl" alt="@Model.Libelle" class="img-fluid rounded shadow" />
        </div>
        <div class="col-md-6 h-100 align-content-center">
            <h1 class="fw-bold">@Model.Libelle</h1>
            <h3 class="fw-light">@Model.Desc</h3>
            <h2 class="fw-bold">@Model.Prix F CFA</h2>

            @if (User.Identity.IsAuthenticated)
            {
                <a href="/commande/commander?type=burger&id=@Model.Id" class="btn btn-primary btn-lg mt-3">
                    Commander
                </a>
            }
            else
            {
                <a asp-controller="Auth" asp-action="Login"
                    asp-route-returnUrl="@Url.Action("Commander", "Commande", new { type = "burger", id = Model.Id })"
                    class="text-decoration-none text-white btn btn-success">
                    Se Connecter pour continuer
                </a>
            }
        </div>
    </div>
</div>
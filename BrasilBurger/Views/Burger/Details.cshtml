@using Models
@model Burger

@{
    ViewData["Title"] = "Détails du Burger";
    ViewData["PageTitle"] = "Burger";
}

<div class="container py-5">
    <div class="row align-items-center">
        <div class="col-md-6 text-center">
            <img src="@Model.ImageUrl" alt="@Model.Libelle" class="img-fluid burger-img" />
        </div>

        <div class="col-md-6">
            <h2 class="burger-title">@Model.Libelle.ToUpper()</h2>
            @if (Model.BurgerCategorie != null)
            {
                <span class="burger-category">
                    <span class="fw-bold">Categorie: </span>@Model.BurgerCategorie.Nom
                </span>
            }
            <p class="burger-desc"><span class="fw-bold">Description: </span>@Model.Desc</p>
            <h4 class="burger-price"><span class="fw-bold">Prix: </span>@Model.Prix XOF</h4>

            @if (User.Identity.IsAuthenticated)
            {
                <a href="/commande/commander?type=burger&id=@Model.Id" class="btn btn-outline-danger px-4 py-2 mt-3">
                    COMMANDER
                </a>
            }
            else
            {
                <a asp-controller="Auth" asp asp-action="Login"
                    asp-route-returnUrl="@Url.Action("Commander", "Commande", new { type = "burger", id = Model.Id })"
                    class="btn btn-outline-danger px-4 py-2 mt-3">
                    SE CONNECTER
                </a>
            }
        </div>

    </div>
</div>
@{
    var burger = ViewBag.Burger;
    ViewData["Title"] = "Commander " + burger.Libelle;
    ViewData["PageTitle"] = "Choix d'un complément";
    var complements = ViewBag.Complements as List<Models.Complement>;
}

<main id="main" class="main">
    <div class="pagetitle">
        <h3>Personnaliser votre commande</h3>
    </div>

    <section class="section">
        <div class="mb-3">
            <a href="#frites" class="btn btn-warning text-white me-2">
                <i class="bi bi-box me-1"></i>Frites
            </a>
            <a href="#boissons" class="btn btn-info text-white">
                <i class="bi bi-cup-straw me-1"></i>Boissons
            </a>
        </div>

        <form method="post" asp-controller="Commande" asp-action="InfosLivraison">
            <input type="hidden" name="type" value="burger" />
            <input type="hidden" name="itemId" value="@burger.Id" />

            <div id="frites" class="mb-5">
                <div class="card shadow-sm">
                    <div class="card-header bg-white">
                        <h5 class="mb-0">
                            <i class="bi bi-box me-2 text-warning"></i>
                            Nos Frites
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            @foreach (var comp in complements.Where(c => c.TypeComplement ==
                                                        Models.TypeComplement.FRITE))
                            {
                                <div class="col-lg-3 col-md-4 col-sm-6">
                                    <label class="w-100">
                                        <input type="checkbox" name="selectedComplements" value="@comp.Id"
                                            class="d-none complement-check" />

                                        <div class="card h-100 complement-card">
                                            <div class="position-relative" style="height: 180px;">
                                                <img src="@comp.ImageUrl" class="w-100 h-100" alt="@comp.Libelle"
                                                    style="object-fit: cover;" />
                                                <div class="position-absolute top-0 end-0 p-2">
                                                    <span class="badge bg-warning check-indicator" style="display: none;">
                                                        <i class="bi bi-check-circle-fill"></i>
                                                    </span>
                                                </div>
                                            </div>

                                            <div class="card-body text-center">
                                                <h6 class="fw-bold mb-2">@comp.Libelle</h6>
                                                <p class="mb-3">
                                                    <span class="fw-bold text-success">@comp.Prix</span>
                                                    <small class="text-muted">XOF</small>
                                                </p>

                                                <span class="btn btn-outline-warning btn-sm w-100 select-btn">
                                                    <i class="bi bi-plus-circle me-1"></i>Ajouter
                                                </span>
                                                <span class="btn btn-warning text-white btn-sm w-100 selected-btn"
                                                    style="display: none;">
                                                    <i class="bi bi-check-circle me-1"></i>Ajouté
                                                </span>
                                            </div>
                                        </div>
                                    </label>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <div id="boissons" class="mb-4">
                <div class="card shadow-sm">
                    <div class="card-header bg-white">
                        <h5 class="mb-0">
                            <i class="bi bi-cup-straw me-2 text-info"></i>
                            Nos Boissons
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            @foreach (var comp in complements.Where(c => c.TypeComplement ==
                                                        Models.TypeComplement.BOISSON))
                            {
                                <div class="col-lg-3 col-md-4 col-sm-6">
                                    <label class="w-100">
                                        <input type="checkbox" name="selectedComplements" value="@comp.Id"
                                            class="d-none complement-check" />

                                        <div class="card h-100 complement-card">
                                            <div class="position-relative" style="height: 180px;">
                                                <img src="@comp.ImageUrl" class="w-100 h-100" alt="@comp.Libelle"
                                                    style="object-fit: cover;" />
                                                <div class="position-absolute top-0 end-0 p-2">
                                                    <span class="badge bg-info check-indicator" style="display: none;">
                                                        <i class="bi bi-check-circle-fill"></i>
                                                    </span>
                                                </div>
                                            </div>

                                            <div class="card-body text-center">
                                                <h6 class="fw-bold mb-2">@comp.Libelle</h6>
                                                <p class="mb-3">
                                                    <span class="fw-bold text-success">@comp.Prix</span>
                                                    <small class="text-muted">XOF</small>
                                                </p>

                                                <span class="btn btn-outline-info btn-sm w-100 select-btn">
                                                    <i class="bi bi-plus-circle me-1"></i>Ajouter
                                                </span>
                                                <span class="btn btn-info text-white btn-sm w-100 selected-btn"
                                                    style="display: none;">
                                                    <i class="bi bi-check-circle me-1"></i>Ajouté
                                                </span>
                                            </div>
                                        </div>
                                    </label>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-between align-items-center">
                <span class="text-muted">
                    <span id="selectedCount">0</span> complément(s) sélectionné(s)
                </span>
                <button type="submit" class="btn btn-success btn-lg px-4">
                    Continuer <i class="bi bi-arrow-right ms-2"></i>
                </button>
            </div>
        </form>
    </section>
</main>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const checkboxes = document.querySelectorAll('.complement-check');
        const selectedCountSpan = document.getElementById('selectedCount');

        function updateSelectedCount() {
            const count = document.querySelectorAll('.complement-check:checked').length;
            selectedCountSpan.textContent = count;
        }

        checkboxes.forEach(checkbox => {
            checkbox.addEventListener('change', function () {
                const card = this.nextElementSibling;
                const selectBtn = card.querySelector('.select-btn');
                const selectedBtn = card.querySelector('.selected-btn');
                const checkIndicator = card.querySelector('.check-indicator');

                if (this.checked) {
                    selectBtn.style.display = 'none';
                    selectedBtn.style.display = 'block';
                    checkIndicator.style.display = 'block';
                } else {
                    selectBtn.style.display = 'block';
                    selectedBtn.style.display = 'none';
                    checkIndicator.style.display = 'none';
                }

                updateSelectedCount();
            });
        });

        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                e.preventDefault();
                const target = document.querySelector(this.getAttribute('href'));
                if (target) {
                    target.scrollIntoView({ behavior: 'smooth', block: 'start' });
                }
            });
        });

        updateSelectedCount();
    });
</script>
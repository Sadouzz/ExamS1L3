@{
    var burger = ViewBag.Burger;
    ViewData["Title"] = "Commander " + burger.Libelle;
    ViewData["PageTitle"] = "Choix d'un complément";
    var complements = ViewBag.Complements as List<Models.Complement>;
}

<div class="container mt-5">
    <h2 class="mb-4">Commander : @burger.Libelle</h2>
    <nav class="mb-4">
        <ul class="list-inline">
            <li class="list-inline-item">
                <a href="#frites" class="btn back-yellow text-white fw-semibold rounded-1">
                    Frites
                </a>
            </li>
            <li class="list-inline-item">
                <a href="#boissons" class="btn back-yellow text-white fw-semibold rounded-1">
                    Boissons
                </a>
            </li>
        </ul>
    </nav>


    <form method="post" asp-controller="Commande" asp-action="InfosLivraison">
        <input type="hidden" name="type" value="burger" />
        <input type="hidden" name="itemId" value="@burger.Id" />

        <h5 id="frites" class="fw-bold mb-3 text-uppercase">Nos Frites</h5>

        <div class="row">
            @foreach (var comp in complements.Where(c => c.TypeComplement == Models.TypeComplement.FRITE))
            {
                <div class="col-md-3 mb-4">
                    <label class="w-100">
                        <input type="checkbox" name="selectedComplements" value="@comp.Id"
                            class="d-none complement-check" />

                        <div class="card shadow rounded-1 border-0 h-100 bg-transparent complement-card">
                            <div class="back-red h-100 w-100">
                                <div class="card-body text-center text-white">
                                    <img src="@comp.ImageUrl" class="card-img-top mb-3" alt="@comp.Libelle"
                                        style="max-height:150px; object-fit:cover;" />

                                    <h6 class="card-title text-uppercase">@comp.Libelle</h6>
                                    <p class="card-text">@comp.Prix XOF</p>

                                    <span class="btn btn-outline-danger btn-sm rounded-pill">
                                        Commander
                                    </span>
                                </div>
                            </div>
                        </div>
                    </label>
                </div>
            }
        </div>

        <h5 id="boissons" class="fw-bold mb-3 text-uppercase mt-4">
            Nos Boissons
        </h5>

        <div class="row">
            @foreach (var comp in complements.Where(c => c.TypeComplement == Models.TypeComplement.BOISSON))
            {
                <div class="col-md-3 mb-4">
                    <label class="w-100">
                        <input type="checkbox" name="selectedComplements" value="@comp.Id"
                            class="d-none complement-check" />

                        <div class="card shadow rounded-1 border-0 h-100 bg-transparent complement-card">
                            <div class="back-red h-100 w-100">
                                <div class="card-body text-center text-white">
                                    <img src="@comp.ImageUrl" class="card-img-top mb-3" alt="@comp.Libelle"
                                        style="max-height:150px; object-fit:cover;" />

                                    <h6 class="card-title text-uppercase">@comp.Libelle</h6>
                                    <p class="card-text">@comp.Prix XOF</p>

                                    <span class="btn btn-outline-danger btn-sm rounded-pill">
                                        Commander
                                    </span>
                                </div>
                            </div>
                        </div>
                    </label>
                </div>
            }
        </div>



        <div class="row">
            @foreach (var comp in complements)
            {
                <div class="col-md-3 mb-4">
                    <label class="w-100">
                        <input type="checkbox" name="selectedComplements" value="@comp.Id"
                            class="d-none complement-check" />

                        <div class="card shadow rounded-1 border-0 h-100 bg-transparent complement-card">
                            <div class="back-red h-100 w-100">
                                <div class="card-body text-center text-white">
                                    <img src="@comp.ImageUrl" class="card-img-top mb-3" alt="@comp.Libelle"
                                        style="max-height: 150px; object-fit: cover;" />

                                    <h5 class="card-title text-uppercase">
                                        @comp.Libelle
                                    </h5>

                                    <p class="card-text">
                                        @comp.Prix F CFA
                                    </p>
                                </div>
                            </div>
                        </div>
                    </label>
                </div>
            }
        </div>

        <button class="btn btn-primary mt-3 px-5 rounded-pill">
            Continuer
        </button>
    </form>
</div>
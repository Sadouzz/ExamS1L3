@using Models
@model Catalog
@{
    ViewData["Title"] = "Catalogue";
    ViewData["PageTitle"] = "Catalogue";
}

<main id="main" class="main">
    <div class="pagetitle">
        <h3>Notre Catalogue</h3>
        <nav>
            <ol class="breadcrumb">
                <li class="breadcrumb-item">Accueil</li>
                <li class="breadcrumb-item active">Catalogue</li>
            </ol>
        </nav>
    </div>

    <section class="section">
        <!-- Navigation rapide -->
        <div class="mb-4">
            <a href="#burgers" class="btn btn-primary me-2">
                <i class="bi bi-list me-1"></i>Burgers
            </a>
            <a href="#menus" class="btn btn-warning text-white">
                <i class="bi bi-box-seam me-1"></i>Menus
            </a>
        </div>

        <!-- Section Burgers -->
        <div id="burgers" class="mb-5">
            <div class="card shadow-sm">
                <div class="card-header bg-white">
                    <h4 class="mb-0">
                        <i class="bi bi-list me-2 text-primary"></i>
                        Nos Burgers
                    </h4>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        @foreach (var burger in Model.Burgers)
                        {
                            @Html.Partial("~/Views/Burger/BurgerCard.cshtml", burger)
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Section Menus -->
        <div id="menus">
            <div class="card shadow-sm">
                <div class="card-header bg-white">
                    <h4 class="mb-0">
                        <i class="bi bi-box-seam me-2 text-warning"></i>
                        Nos Menus
                    </h4>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        @foreach (var menu in Model.Menus)
                        {
                            @Html.Partial("~/Views/Menu/MenuCard.cshtml", menu)
                        }
                    </div>
                </div>
            </div>
        </div>
    </section>
</main>

<script>
    // Smooth scroll
    document.querySelectorAll('a[href^="#"]').forEach(anchor => {
        anchor.addEventListener('click', function (e) {
            e.preventDefault();
            const target = document.querySelector(this.getAttribute('href'));
            if (target) {
                target.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }
        });
    });
</script>
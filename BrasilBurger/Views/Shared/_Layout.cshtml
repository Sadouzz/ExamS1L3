@using System.Security.Claims
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BrasilBurger</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/BrasilBurger.styles.css" asp-append-version="true" />
</head>

<body>
    <header class="text-white back-red">
    <nav class="navbar navbar-expand-lg navbar-dark px-4">
        <div class="container-fluid">

            <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Catalog" asp-action="Index">
                <img src="~/img/burger.png" alt="Logo" class="logo">
                <span class="title">BrasilBurger</span>
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                    data-bs-target="#mainNavbar">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="mainNavbar">

                <ul class="navbar-nav mx-auto gap-lg-4 text-center">
                    <li class="nav-item">
                        <a asp-controller="Catalog" asp-action="Index" class="nav-link">
                            Catalogue
                        </a>
                    </li>

                    @if (User.Identity.IsAuthenticated)
                    {
                        <li class="nav-item">
                            <a asp-controller="Commande" asp-action="UserCommandes"
                               asp-route-id="@User.FindFirst(ClaimTypes.NameIdentifier)?.Value"
                               class="nav-link">
                                Mes commandes
                            </a>
                        </li>
                    }
                </ul>

                <div class="d-flex align-items-center gap-3 flex-column flex-lg-row text-center">

                    <div class="search d-flex align-items-center px-3 py-2">
                        <i class="bi bi-search me-2"></i>
                        <span class="search-btn">Rechercher</span>
                    </div>

                    @if (User.Identity.IsAuthenticated)
                    {
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-person-fill"></i>
                            <span>@User.Identity.Name</span>
                            <a asp-controller="Auth" asp-action="Logout"
                               class="btn btn-secondary btn-sm">
                                Déconnexion
                            </a>
                        </div>
                    }
                    else
                    {
                        <a asp-controller="Auth" asp-action="Login"
                           class="btn btn-secondary btn-sm">
                            Se connecter
                        </a>
                    }
                </div>
            </div>
        </div>
    </nav>

    <div class="back-yellow px-4 py-3 text-center text-lg-start">
        <h2 class="m-0">@ViewData["PageTitle"]</h2>
    </div>
</header>

    <div class="container-fluid">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
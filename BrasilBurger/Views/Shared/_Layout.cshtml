@using System.Security.Claims
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BrasilBurger</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/BrasilBurger.styles.css" asp-append-version="true" />
</head>

<body>
    <header class="text-white back-red">
        <div class="container-fluid px-5 py-3">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div class="d-flex align-items-center gap-2">
                    <img src="~/img/burger.png" alt="Logo" class="logo">
                    <span class="title">BrasilBurger</span>
                </div>

                <div class="search d-flex align-items-center px-3">
                    <i class="bi bi-search"></i>
                    <span class="search-btn">Rechercher</span>
                </div>

                <div class="d-flex align-items-center gap-4">
                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <div>
                            <i class="bi bi-person-fill"></i> @User.Identity.Name
                            <a asp-controller="Auth" asp-action="Logout"
                                class="text-decoration-none text-white btn btn-secondary">Déconnexion</a>
                        </div>
                    }
                    else
                    {
                        <a asp-controller="Auth" asp-action="Login" class="text-decoration-none text-white">
                            Se Connecter
                        </a>
                    }


                </div>
            </div>

            <nav class="d-flex justify-content-center gap-5">
                <a asp-controller="Catalog" asp-action="Index" class="nav">
                    Catalogue
                </a>

                @if (User.Identity.IsAuthenticated)
                {
                    <a asp-controller="Commande" asp-action="UserCommandes"
                        asp-route-id="@User.FindFirst(ClaimTypes.NameIdentifier)?.Value" class="nav">
                        Mes commandes
                    </a>
                }

            </nav>

        </div>
        <div class="back-yellow px-5 py-3">
            <h2 class="m-0">
                @ViewData["PageTitle"]
            </h2>
        </div>
    </header>
    <div class="container-fluid">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>